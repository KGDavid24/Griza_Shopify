{% comment %}
  Griza product page styling.

  Applies the brand treatment used by the homepage featured section to the
  stock product-information blocks. Deliberately styles the existing markup
  rather than replacing the section: quick-add.js fetches this page and lifts
  its `.product-details` element into the quick-add modal, so the modal
  inherits all of this for free — and replacing the section would break it.
{% endcomment %}

{%- comment -%}
  The tiled ginger field, matching every other navy surface on the site.
  This has to be an inline style tag, not the theme stylesheet tag: the latter
  is served as static CSS and never resolves the Liquid asset URL.
  Painted as two background layers on the section's own background element:
  a near-opaque navy wash over the pattern, which gives the ~10% strength
  without needing a pseudo-element (the background div's positioning is
  Horizon's to control, not ours).

  NOTE: never write theme CSS tag names in braces inside a comment here - the
  compiler scans for them literally and will treat one as a real block opener,
  which corrupts the compiled stylesheet for the whole site.
{%- endcomment -%}
{%- assign griza_pattern = 'griza-gingern-pattern.svg' | file_url -%}
{%- if griza_pattern != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} .section-background {
      background-image:
        linear-gradient(rgba(29, 25, 57, 0.90), rgba(29, 25, 57, 0.90)),
        url('{{ griza_pattern }}');
      background-repeat: repeat, repeat;
      background-size: auto, 380px;
      background-position: center, center;
    }

    /* Orange stripe closing the navy block, same device as the contact page */
    #shopify-section-{{ section.id }} {
      border-bottom: 6px solid #ed6d1d;
    }

    /* Sticky bar: navy + ginger so it reads as part of the brand rather than
       a floating browser chrome strip.

       Deliberately NOT scoped to the section id: sticky bars are commonly
       re-parented to <body> when they engage, which would drop a
       section-scoped rule and leave cream text on the theme's cream popover
       background. Scoped to its own custom element instead, which travels with
       it, at (0,2,0) so it outranks .color-custom-popover. */
    .sticky-add-to-cart .sticky-add-to-cart__bar,
    .sticky-add-to-cart__bar.color-custom-popover {
      background-color: #1d1939;
      background-image:
        linear-gradient(rgba(29, 25, 57, 0.92), rgba(29, 25, 57, 0.92)),
        url('{{ griza_pattern }}');
      background-repeat: repeat, repeat;
      background-size: auto, 300px;
      color: #fefadf;
      border-top: 3px solid #ed6d1d;
    }

    /* Horizon frosts the bar with a ::before carrying
       backdrop-filter: blur() saturate() brightness(1.5). Despite z-index:-1 it
       paints above the element's own background, so it was covering our navy
       with a brightened blur of the cream page behind. Remove it — we want a
       solid branded bar, not glass. */
    .sticky-add-to-cart .sticky-add-to-cart__bar::before,
    .sticky-add-to-cart__bar.color-custom-popover::before {
      content: none;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .section-background {
        background-size: auto, 240px;
      }
      .sticky-add-to-cart .sticky-add-to-cart__bar,
      .sticky-add-to-cart__bar.color-custom-popover {
        background-size: auto, 200px;
      }
    }
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  .product-information {
    --griza-accent: #ed6d1d;
    --griza-ink: #1d1939;
    --griza-cream: #fefadf;
  }

  /* ---------- Eyebrow above the title ---------- */
  .product-details .griza-eyebrow p,
  .product-details .griza-eyebrow {
    font-family: 'Barlow', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--griza-accent);
    margin: 0;
  }

  /* ---------- Price as a sticker, matching the featured section ---------- */
  .product-details .price {
    display: inline-block;
    background: var(--griza-accent);
    color: var(--griza-cream);
    font-family: var(--font-heading--family);
    line-height: 1;
    padding: 10px 20px 6px;
    transform: rotate(-3deg);
    box-shadow: 6px 6px 0 0 var(--griza-ink);
  }

  .product-details .price * {
    color: inherit;
  }

  /* The sticker is rotated and carries a hard shadow, so its painted box sits
     lower than its layout box — the tax note needs real clearance or the two
     collide. */
  .product-details .price {
    margin-bottom: 10px;
  }

  .product-details .tax-note {
    display: block;
    clear: both;
    margin-top: 30px;
    font-family: 'Barlow', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--griza-cream);
    opacity: 0.55;
  }

  /* ---------- Light-on-dark: hero and quick-add modal both run navy ---------- */

  /* The stepper keeps a cream fill (matching an unselected variant button), so
     its glyphs and value must be navy — cream-on-cream made the +/- invisible. */
  .product-details .quantity-selector {
    background-color: var(--griza-cream);
    border-color: var(--griza-accent);
  }

  .product-details .quantity-selector button,
  .product-details .quantity-selector input,
  .product-details .quantity-selector .svg-wrapper,
  .product-details .quantity-selector svg {
    color: var(--griza-ink);
  }

  .product-details .quantity-selector button:hover {
    color: var(--griza-accent);
  }

  /* Sticky bar text sits on navy */
  .sticky-add-to-cart__bar .sticky-add-to-cart__title,
  .sticky-add-to-cart__bar .sticky-add-to-cart__variant,
  .sticky-add-to-cart__bar .price,
  .sticky-add-to-cart__bar p,
  .sticky-add-to-cart__bar span:not(.visually-hidden) {
    color: #fefadf;
  }

  /* ...but the CTA keeps its own orange treatment */
  .sticky-add-to-cart__bar .add-to-cart-button,
  .sticky-add-to-cart__bar .add-to-cart-button span {
    color: var(--griza-cream);
  }

  .product-details .payment-terms,
  .product-details .product-form__submit + a,
  .product-details a:not(.button) {
    color: var(--griza-cream);
  }

  /* ---------- Variant buttons ---------- */
  .product-details .variant-option__button-label {
    font-family: var(--font-heading--family);
    font-size: 20px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-width: 2px;
    border-radius: 0;
    padding-block: 14px 10px;
    transition: transform .15s ease;
  }

  .product-details .variant-option__button-label:has(input:checked) {
    transform: translateY(-2px);
  }

  /* ---------- Add to cart: the bitten edge ---------- */
  .product-details .add-to-cart-button,
  .quick-add-modal .add-to-cart-button {
    font-family: var(--font-heading--family);
    font-size: 24px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    min-height: 58px;
    border-radius: 0;
    clip-path: polygon(0% 0%, 94% 0%, 97% 10%, 94% 20%, 100% 32%, 95% 48%, 100% 62%, 94% 78%, 98% 90%, 93% 100%, 0% 100%);
    transition: transform .18s ease, filter .18s ease;
  }

  .product-details .add-to-cart-button:hover:not([disabled]),
  .quick-add-modal .add-to-cart-button:hover:not([disabled]) {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  /* Quantity stepper reads as a sibling of the button, not an afterthought */
  .product-details .quantity-selector {
    border-width: 2px;
    border-radius: 0;
    min-height: 58px;
  }

  /* ---------- Rhythm ---------- */
  .product-details .variant-picker__option-name,
  .product-details .product-form__label {
    font-family: 'Barlow', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .product-details .price { font-size: 46px; }
    .product-details { padding-block-start: 8px; }
  }

  @media screen and (max-width: 749px) {
    .product-details .price { font-size: 34px; }
    .product-details .add-to-cart-button { font-size: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-details .add-to-cart-button,
    .product-details .variant-option__button-label { transition: none; }
  }
{% endstylesheet %}
